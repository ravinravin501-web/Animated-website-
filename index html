<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ravin Tech Solution</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#03030a;
  color:white;
  overflow-x:hidden;
}

/* BACKGROUND */
.bg{
  position:fixed;
  inset:0;
  z-index:-2;
  background:
    radial-gradient(circle at 20% 20%, #2411ff55, transparent 35%),
    radial-gradient(circle at 80% 30%, #b000ff55, transparent 35%),
    radial-gradient(circle at 50% 90%, #00ccff33, transparent 40%),
    #03030a;
}

.particles{
  position:fixed;
  inset:0;
  z-index:-1;
  background-image:
    linear-gradient(#ffffff22 1px, transparent 1px),
    linear-gradient(90deg,#ffffff18 1px, transparent 1px);
  background-size:60px 60px;
  animation:moveGrid 15s linear infinite;
  opacity:.25;
}

/* NAV */
nav{
  position:fixed;
  top:15px;
  left:50%;
  transform:translateX(-50%);
  width:92%;
  max-width:1100px;
  padding:14px 18px;
  background:rgba(255,255,255,.08);
  backdrop-filter:blur(15px);
  border:1px solid rgba(255,255,255,.15);
  border-radius:25px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  z-index:99;
}

.logo{
  font-size:20px;
  font-weight:900;
  letter-spacing:1px;
}

.logo span{
  color:#00d9ff;
}

nav a{
  color:white;
  text-decoration:none;
  font-size:14px;
  margin-left:12px;
}

/* HERO */
.hero{
  min-height:100vh;
  padding:120px 22px 60px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.hero-box{
  max-width:850px;
  animation:fadeUp 1s ease;
}

.badge{
  display:inline-block;
  padding:10px 18px;
  border-radius:30px;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);
  color:#00d9ff;
  margin-bottom:25px;
}

.hero h1{
  font-size:58px;
  line-height:1.05;
  margin-bottom:25px;
}

.hero h1 span{
  background:linear-gradient(90deg,#00d9ff,#b000ff,#ff3df2);
  -webkit-background-clip:text;
  color:transparent;
}

.hero p{
  max-width:650px;
  margin:auto;
  color:#cfcfff;
  font-size:18px;
  line-height:1.7;
  margin-bottom:35px;
}

.btn{
  display:inline-block;
  padding:16px 30px;
  background:linear-gradient(90deg,#00d9ff,#8b00ff);
  color:white;
  text-decoration:none;
  border-radius:40px;
  font-weight:bold;
  box-shadow:0 0 35px #00d9ff80;
  transition:.3s;
}

.btn:hover{
  transform:scale(1.05);
  box-shadow:0 0 55px #b000ff;
}

/* SECTIONS */
section{
  padding:80px 22px;
}

.title{
  text-align:center;
  font-size:38px;
  margin-bottom:45px;
}

.title span{
  color:#00d9ff;
}

/* CARDS */
.cards{
  max-width:1100px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:25px;
}

.card{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  backdrop-filter:blur(18px);
  border-radius:28px;
  padding:30px;
  min-height:210px;
  transition:.4s;
  animation:float 4s ease-in-out infinite;
}

.card:hover{
  transform:translateY(-12px) scale(1.02);
  box-shadow:0 0 35px #00d9ff55;
}

.card h3{
  color:#00d9ff;
  font-size:22px;
  margin-bottom:15px;
}

.card p{
  color:#d0d0e8;
  line-height:1.6;
}

/* SHOWCASE */
.showcase{
  max-width:1050px;
  margin:auto;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.14);
  border-radius:35px;
  padding:35px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:center;
  box-shadow:0 0 50px rgba(0,217,255,.15);
}

.screen{
  height:320px;
  border-radius:25px;
  background:
    linear-gradient(135deg,#111,#090030),
    radial-gradient(circle,#00d9ff,transparent);
  border:1px solid rgba(255,255,255,.18);
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  overflow:hidden;
}

.screen::before{
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  background:#00d9ff;
  filter:blur(80px);
  animation:moveGlow 5s infinite alternate;
}

.screen h2{
  position:relative;
  font-size:34px;
  text-align:center;
}

.showcase p{
  color:#ddd;
  line-height:1.8;
  font-size:17px;
}

/* CONTACT */
.contact{
  text-align:center;
}

.contact-box{
  max-width:800px;
  margin:auto;
  padding:45px 25px;
  border-radius:35px;
  background:linear-gradient(135deg,rgba(0,217,255,.15),rgba(176,0,255,.15));
  border:1px solid rgba(255,255,255,.18);
}

.whatsapp{
  display:inline-block;
  margin-top:25px;
  padding:15px 30px;
  background:#25D366;
  color:white;
  text-decoration:none;
  border-radius:40px;
  font-weight:bold;
}

footer{
  padding:25px;
  text-align:center;
  color:#aaa;
}

/* ANIMATION */
.reveal{
  opacity:0;
  transform:translateY(50px);
  transition:1s;
}

.reveal.active{
  opacity:1;
  transform:translateY(0);
}

@keyframes fadeUp{
  from{opacity:0;transform:translateY(50px);}
  to{opacity:1;transform:translateY(0);}
}

@keyframes moveGrid{
  from{background-position:0 0;}
  to{background-position:120px 120px;}
}

@keyframes float{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-8px);}
}

@keyframes moveGlow{
  from{transform:translate(-80px,-50px);}
  to{transform:translate(80px,60px);}
}

/* MOBILE */
@media(max-width:700px){
  nav{
    padding:12px;
  }

  nav a{
    font-size:12px;
    margin-left:7px;
  }

  .hero h1{
    font-size:39px;
  }

  .hero p{
    font-size:16px;
  }

  .title{
    font-size:30px;
  }

  .showcase{
    grid-template-columns:1fr;
    padding:22px;
  }

  .screen{
    height:250px;
  }
}
</style>
</head>

<body>

<div class="bg"></div>
<div class="particles"></div>

<nav>
  <div class="logo">Ravin <span>Tech</span></div>
  <div>
    <a href="#services">Services</a>
    <a href="#work">Design</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<div class="hero">
  <div class="hero-box">
    <div class="badge">Creative Digital Experience</div>

    <h1>We Create <span>Premium Websites</span> For Your Brand</h1>

    <p>
      Ravin Tech Solution builds modern, mobile-friendly, animated websites
      with powerful design, smooth effects and professional style.
    </p>

    <a href="#contact" class="btn">Start Your Website</a>
  </div>
</div>

<section id="services" class="reveal">
  <h2 class="title">Our <span>Services</span></h2>

  <div class="cards">
    <div class="card">
      <h3>Website Design</h3>
      <p>Modern websites for business, personal brand, political pages and services.</p>
    </div>

    <div class="card">
      <h3>Mobile Version</h3>
      <p>Perfect design for Android, iPhone, tablet and desktop screens.</p>
    </div>

    <div class="card">
      <h3>Landing Page</h3>
      <p>High quality single page website for product launch, promotion and ads.</p>
    </div>

    <div class="card">
      <h3>Animation UI</h3>
      <p>Neon glow, glass cards, smooth scroll effects and modern motion style.</p>
    </div>
  </div>
</section>

<section id="work" class="reveal">
  <h2 class="title">Design <span>Experience</span></h2>

  <div class="showcase">
    <div class="screen">
      <h2>Ravin Tech<br>Solution</h2>
    </div>

    <div>
      <p>
        Your website is your online identity. We create attractive,
        fast-loading and trust-building websites with a premium digital look.
        This design uses neon blue, purple glow, glass effect cards,
        animated background and smooth mobile layout.
      </p>
    </div>
  </div>
</section>

<section id="contact" class="contact reveal">
  <div class="contact-box">
    <h2 class="title">Create Your Website Today</h2>
    <p>Contact Ravin Tech Solution and start your digital journey.</p>

    <a class="whatsapp" href="https://wa.me/919042458779">
      Chat on WhatsApp
    </a>
  </div>
</section>

<footer>
  © 2026 Ravin Tech Solution. All Rights Reserved.
</footer>

<script>
const reveals = document.querySelectorAll(".reveal");

window.addEventListener("scroll", () => {
  reveals.forEach(section => {
    const top = section.getBoundingClientRect().top;
    const windowHeight = window.innerHeight;

    if(top < windowHeight - 100){
      section.classList.add("active");
    }
  });
});
</script>

</body>
</html>
